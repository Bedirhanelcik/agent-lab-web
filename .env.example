# Sunucu tarafı. "false" yazılmadıkça uygulama demo modunda kalır.
# P2'de canlı mod henüz uygulanmadı; bu değişken ileride (P5) anlam kazanacak.
DEMO_MODE=true

# Tarayıcıya açılan tek değerler: herkese açık profil bağlantıları.
# Tanımsız bırakılırsa ilgili bağlantı hiç render edilmez.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Canlı mod (sunucu tarafı, tarayıcıya ASLA verilmez).
# DEMO_MODE=false iken playground bu adresteki /agent/ask uç noktasını çağırır.
# AGENT_API_URL=http://localhost:8000
# İstek zaman aşımı (ms, varsayılan 45000):
# AGENT_API_TIMEOUT_MS=45000
